APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=poshan
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Chatbot Configuration
CHATBOT_API_ENDPOINT=
CHATBOT_API_KEY=

# Fonnte WhatsApp API Configuration
FONNTE_TOKEN=your_fonnte_token_here
FONNTE_URL=https://api.fonnte.com/send

# Admin WhatsApp (format: 628xxx without +)
ADMIN_WHATSAPP=628976688800

# Company Information
COMPANY_PHONE=08976688800
COMPANY_NAME="HM Tour"
COMPANY_EMAIL=info@hmtour.com

# InterActive QRIS Payment Gateway
# Dokumentasi: https://qris.interactive.co.id/api-doc/
QRIS_API_KEY=
QRIS_MERCHANT_ID=
QRIS_NMID=
QRIS_MERCHANT_NAME="HM TOUR AND TRAVEL"
QRIS_BASE_URL=https://qris.interactive.co.id/restapi/qris/show_qris.php
QRIS_CHECK_URL=https://qris.interactive.co.id/restapi/qris/checkpaid_qris.php
