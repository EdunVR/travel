<?php

namespace App\Http\Controllers;

use App\Models\Production;
use App\Models\ProductionMaterial;
use App\Models\ProductionLaborCost;
use App\Models\ProductionOperationalCost;
use App\Models\MonthlyProductionCost;
use App\Models\Produk;
use App\Models\Bahan;
use App\Models\BahanDetail;
use App\Models\HppProduk;
use App\Models\Outlet;
use App\Models\Attendance;
use App\Exports\ProductionsExport;
use App\Traits\HasOutletFilter;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Log;
use Illuminate\Support\Facades\Validator;
use Illuminate\Validation\Rule;
use Maatwebsite\Excel\Facades\Excel;
use Yajra\DataTables\Facades\DataTables;

class ProductionController extends Controller
{
    use HasOutletFilter;

    public function __construct()
    {
        $this->middleware('auth');
    }

    /**
     * Generate PDF report for production details
     */
    public function generatePdf($id)
    {
        try {
            Log::info('Generate PDF Start', [
                'id' => $id,
                'user_id' => auth()->id(),
                'user_name' => auth()->user()->name ?? 'Unknown'
            ]);

            $production = Production::with([
                'product.hppProduk', 
                'materials', 
                'laborCosts',
                'operationalCosts',
                'realizations', 
                'creator', 
                'approver',
                'outlet',
                'hppRecords.product'
            ])->findOrFail($id);

            Log::info('Production found for PDF generation', [
                'id' => $id,
                'production_code' => $production->production_code,
                'product_name' => $production->product->nama_produk ?? 'N/A'
            ]);

            // Manually load the material relationships based on type
            foreach ($production->materials as $material) {
                if ($material->material_type === 'bahan') {
                    $bahan = Bahan::with('hargaBahan')->find($material->material_id);
                    $material->setRelation('material', $bahan);
                } else {
                    $produk = Produk::find($material->material_id);
                    $material->setRelation('material', $produk);
                }
            }

            // Calculate costs
            $materialCost = $production->materials->sum(function($material) {
                if ($material->material_type === 'bahan') {
                    $bahan = $material->material;
                    if ($bahan && $bahan->hargaBahan && $bahan->hargaBahan->isNotEmpty()) {
                        $hargaBahan = $bahan->hargaBahan->first();
                        return $material->quantity_required * ($hargaBahan->harga_beli ?? 0);
                    }
                    return 0;
                } else {
                    $produk = $material->material;
                    if ($produk && method_exists($produk, 'calculateHpp')) {
                        return $material->quantity_required * ($produk->calculateHpp() ?? 0);
                    }
                    return 0;
                }
            });
            
            $laborCost = $production->laborCosts->sum(function($labor) {
                return $labor->worker_count * $labor->cost_per_worker;
            });
            
            $operationalCost = $production->operationalCosts->sum('amount');
            $totalCost = $materialCost + $laborCost + $operationalCost;
            
            $hppCalculation = [
                'material_cost' => $materialCost,
                'labor_cost' => $laborCost,
                'operational_cost' => $operationalCost,
                'total_cost' => $totalCost,
                'hpp_per_unit' => $production->target_quantity > 0 ? $totalCost / $production->target_quantity : 0
            ];

            Log::info('PDF calculations completed', [
                'id' => $id,
                'total_cost' => $totalCost,
                'hpp_per_unit' => $hppCalculation['hpp_per_unit']
            ]);

            // Generate PDF using DomPDF
            $pdf = app('dompdf.wrapper');
            $pdf->loadView('admin.produksi.produksi.pdf', compact('production', 'hppCalculation'));
            $pdf->setPaper('A4', 'portrait');
            
            $filename = 'Laporan_Produksi_' . $production->production_code . '_' . date('Y-m-d') . '.pdf';
            
            Log::info('PDF generated successfully', [
                'id' => $id,
                'filename' => $filename
            ]);
            
            return $pdf->stream($filename);

        } catch (\Exception $e) {
            Log::error('Production PDF Generation Error', [
                'id' => $id,
                'error' => $e->getMessage(),
                'trace' => $e->getTraceAsString(),
                'line' => $e->getLine(),
                'file' => $e->getFile()
            ]);
            
            return response()->json([
                'success' => false,
                'message' => 'Gagal membuat laporan PDF'
            ], 500);
        }
    }

    /**
     * Display production index page
     */
    public function index(Request $request)
    {
        $selectedOutlet = $this->getSelectedOutlet($request);
        $outlets = $this->getAccessibleOutlets();
        
        // Get monthly cost stats for current outlet
        $monthlyCostStats = null;
        $monthlyCostHistory = collect();
        
        if ($selectedOutlet && $selectedOutlet !== 'ALL') {
            // Get current month data
            $monthlyCostStats = MonthlyProductionCost::getCurrentPeriodCost($selectedOutlet);
            
            // Get history (last 12 months)
            $monthlyCostHistory = MonthlyProductionCost::byOutlet($selectedOutlet)
                ->latest()
                ->limit(12)
                ->get();
        }
        
        return view('admin.produksi.produksi.index', compact(
            'selectedOutlet', 
            'outlets', 
            'monthlyCostStats', 
            'monthlyCostHistory'
        ));
    }

    /**
     * Get production data for DataTables
     */
    public function getData(Request $request)
    {
        Log::info('🔄 [PRODUCTION DATA] Starting getData request', [
            'request_params' => $request->all(),
            'user_id' => auth()->id(),
            'timestamp' => now()->toDateTimeString()
        ]);

        $outletId = $this->getSelectedOutlet($request);
        Log::info('🏢 [PRODUCTION DATA] Selected outlet', [
            'outlet_id' => $outletId,
            'from_request' => $request->get('outlet_id'),
            'from_session' => session('selected_outlet')
        ]);
        
        $query = Production::with(['product', 'outlet', 'laborCosts', 'operationalCosts', 'realizations', 'materials', 'hppRecords.product']);

        // Filter by outlet - only if specific outlet is selected
        if ($outletId && $outletId !== 'ALL' && $outletId !== '') {
            $query->where('outlet_id', $outletId);
            Log::info('🔍 [PRODUCTION DATA] Outlet filter applied', ['outlet_id' => $outletId]);
        } else {
            Log::info('🔍 [PRODUCTION DATA] Outlet filter skipped - showing all outlets', ['outlet_id' => $outletId]);
        }

        Log::info('🔍 [PRODUCTION DATA] Base query created', [
            'outlet_id' => $outletId,
            'with_relations' => ['product', 'outlet', 'laborCosts', 'operationalCosts', 'realizations', 'materials', 'hppRecords.product']
        ]);

        // Filter by status
        if ($request->filled('status') && strtolower($request->status) !== 'all') {
            $query->where('status', $request->status);
            Log::info('🔍 [PRODUCTION DATA] Status filter applied', ['status' => $request->status]);
        } else {
            Log::info('🔍 [PRODUCTION DATA] Status filter skipped', ['status' => $request->status, 'reason' => 'value is ALL or empty']);
        }

        // Filter by production line
        if ($request->filled('production_line') && strtolower($request->production_line) !== 'all') {
            $query->where('production_line', $request->production_line);
            Log::info('🔍 [PRODUCTION DATA] Production line filter applied', ['production_line' => $request->production_line]);
        } else {
            Log::info('🔍 [PRODUCTION DATA] Production line filter skipped', ['production_line' => $request->production_line, 'reason' => 'value is ALL or empty']);
        }

        // Filter by date range
        if ($request->filled('start_date')) {
            $query->where('start_date', '>=', $request->start_date);
            Log::info('🔍 [PRODUCTION DATA] Start date filter applied', ['start_date' => $request->start_date]);
        }
        if ($request->filled('end_date')) {
            $query->where('end_date', '<=', $request->end_date);
            Log::info('🔍 [PRODUCTION DATA] End date filter applied', ['end_date' => $request->end_date]);
        }

        // Handle grid view request
        if ($request->filled('for_grid')) {
            Log::info('📋 [PRODUCTION DATA] Grid view requested');
            
            try {
                $productions = $query->orderBy('created_at', 'desc')->get();
                Log::info('📋 [PRODUCTION DATA] Query executed', [
                    'total_records' => $productions->count(),
                    'sql' => $query->toSql(),
                    'bindings' => $query->getBindings()
                ]);

                if ($productions->isEmpty()) {
                    Log::warning('⚠️ [PRODUCTION DATA] No productions found', [
                        'outlet_id' => $outletId,
                        'filters' => $request->only(['status', 'production_line', 'start_date', 'end_date'])
                    ]);
                }
                
                // Transform data for grid view
                $gridData = $productions->map(function($production) {
                    Log::debug('🔄 [PRODUCTION DATA] Processing production', [
                        'id' => $production->id,
                        'code' => $production->production_code,
                        'product_id' => $production->product_id,
                        'product_name' => $production->product->nama_produk ?? 'N/A',
                        'hpp_records_count' => $production->hppRecords->count()
                    ]);

                    $realized = $production->realizations->sum('quantity_produced');
                    $rejected = $production->realizations->sum('quantity_rejected');
                    $progress = $production->target_quantity > 0 ? ($realized / $production->target_quantity) * 100 : 0;
                    
                    // Calculate material cost
                    $materialCost = $this->calculateMaterialCost($production);
                    $laborCost = $production->laborCosts->sum('total_cost');
                    $operationalCost = $production->operationalCosts->sum('amount');
                    $totalCost = $materialCost + $laborCost + $operationalCost;
                    $hppPerUnit = $production->target_quantity > 0 ? $totalCost / $production->target_quantity : 0;
                    
                    Log::debug('💰 [PRODUCTION DATA] Cost calculation', [
                        'production_id' => $production->id,
                        'material_cost' => $materialCost,
                        'labor_cost' => $laborCost,
                        'operational_cost' => $operationalCost,
                        'total_cost' => $totalCost,
                        'hpp_per_unit' => $hppPerUnit
                    ]);
                    
                    return [
                        'id' => $production->id,
                        'production_code' => $production->production_code,
                        'product_name' => $production->product->nama_produk ?? '-',
                        'target_quantity' => $production->target_quantity,
                        'target_quantity_formatted' => number_format($production->target_quantity, 0, ',', '.'),
                        'realized_quantity' => $realized,
                        'realized_quantity_formatted' => number_format($realized, 0, ',', '.'),
                        'rejected_quantity' => $rejected,
                        'rejected_quantity_formatted' => number_format($rejected, 0, ',', '.'),
                        'progress' => round($progress, 1),
                        'progress_formatted' => number_format($progress, 1) . '%',
                        'hpp_per_unit' => $hppPerUnit,
                        'hpp_per_unit_formatted' => $hppPerUnit > 0 ? 'Rp ' . number_format($hppPerUnit, 0, ',', '.') : '-',
                        'total_cost' => $totalCost,
                        'total_cost_formatted' => $totalCost > 0 ? 'Rp ' . number_format($totalCost, 0, ',', '.') : '-',
                        'start_date' => $production->start_date ? $production->start_date : null,
                        'end_date' => $production->end_date ? $production->end_date : null,
                        'expiry_date' => $production->expiry_date ? $production->expiry_date : null,
                        'status' => $production->status,
                        'status_formatted' => ucfirst(str_replace('_', ' ', $production->status)),
                        'priority' => $production->priority ?? 'normal',
                        'priority_formatted' => ucfirst($production->priority ?? 'normal'),
                        'production_line' => $production->production_line,
                        'description' => $production->description,
                        'created_at' => $production->created_at->format('d/m/Y H:i'),
                        'hpp_records' => $production->hppRecords->map(function($hpp) {
                            return [
                                'id' => $hpp->id,
                                'product_id' => $hpp->id_produk,
                                'product_name' => $hpp->product ? $hpp->product->nama_produk : 'Unknown',
                                'target_quantity' => $hpp->target_quantity ?? 0,
                                'realized_quantity' => $hpp->realized_quantity ?? 0,
                                'rejected_quantity' => $hpp->rejected_quantity ?? 0,
                            ];
                        }),
                    ];
                });
                
                Log::info('✅ [PRODUCTION DATA] Grid data prepared', [
                    'total_items' => $gridData->count(),
                    'sample_item' => $gridData->first()
                ]);
                
                return response()->json([
                    'success' => true,
                    'data' => $gridData,
                    'debug' => [
                        'outlet_id' => $outletId,
                        'total_records' => $productions->count(),
                        'filters_applied' => $request->only(['status', 'production_line', 'start_date', 'end_date']),
                        'timestamp' => now()->toDateTimeString()
                    ]
                ]);
                
            } catch (\Exception $e) {
                Log::error('💥 [PRODUCTION DATA] Exception in grid data processing', [
                    'error' => $e->getMessage(),
                    'file' => $e->getFile(),
                    'line' => $e->getLine(),
                    'trace' => $e->getTraceAsString()
                ]);
                
                return response()->json([
                    'success' => false,
                    'message' => 'Error processing production data: ' . $e->getMessage(),
                    'error' => $e->getMessage()
                ], 500);
            }
        }

        return DataTables::of($query)
            ->addColumn('product_name', function ($production) {
                return $production->product->nama_produk ?? '-';
            })
            ->editColumn('target_quantity', function ($production) {
                return number_format($production->target_quantity, 0, ',', '.');
            })
            ->addColumn('realized_quantity', function ($production) {
                $realized = $production->realizations->sum('quantity_produced');
                return number_format($realized, 0, ',', '.');
            })
            ->addColumn('progress', function ($production) {
                $realized = $production->realizations->sum('quantity_produced');
                $progress = $production->target_quantity > 0 ? ($realized / $production->target_quantity) * 100 : 0;
                
                return '<div class="flex items-center gap-2">
                    <div class="w-16 bg-slate-200 rounded-full h-2">
                        <div class="bg-primary-600 h-2 rounded-full" style="width: ' . min($progress, 100) . '%"></div>
                    </div>
                    <span class="text-xs font-medium">' . number_format($progress, 1) . '%</span>
                </div>';
            })
            ->addColumn('status_badge', function ($production) {
                $statusColors = [
                    'draft' => 'slate',
                    'approved' => 'blue',
                    'in_progress' => 'yellow',
                    'completed' => 'green',
                    'cancelled' => 'red'
                ];
                $color = $statusColors[$production->status] ?? 'slate';
                
                return '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-' . $color . '-100 text-' . $color . '-700">' 
                    . ucfirst(str_replace('_', ' ', $production->status)) . 
                    '</span>';
            })
            ->addColumn('hpp_per_unit', function ($production) {
                $materialCost = $this->calculateMaterialCost($production);
                $laborCost = $production->laborCosts->sum('total_cost');
                $operationalCost = $production->operationalCosts->sum('amount');
                $totalCost = $materialCost + $laborCost + $operationalCost;
                $hppPerUnit = $production->target_quantity > 0 ? $totalCost / $production->target_quantity : 0;
                return $hppPerUnit > 0 ? 'Rp ' . number_format($hppPerUnit, 0, ',', '.') : '-';
            })
            ->addColumn('total_cost', function ($production) {
                $materialCost = $this->calculateMaterialCost($production);
                $laborCost = $production->laborCosts->sum('total_cost');
                $operationalCost = $production->operationalCosts->sum('amount');
                $totalCost = $materialCost + $laborCost + $operationalCost;
                return $totalCost > 0 ? 'Rp ' . number_format($totalCost, 0, ',', '.') : '-';
            })
            ->editColumn('start_date', function ($production) {
                return $production->start_date ? date('d/m/Y', strtotime($production->start_date)) : '-';
            })
            ->editColumn('end_date', function ($production) {
                return $production->end_date ? date('d/m/Y', strtotime($production->end_date)) : '-';
            })
            ->addColumn('priority_badge', function ($production) {
                $priority = $production->priority ?? 'normal';
                $colors = [
                    'normal' => 'slate',
                    'high' => 'orange',
                    'urgent' => 'red'
                ];
                $color = $colors[$priority] ?? 'slate';
                return '<span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-' . $color . '-100 text-' . $color . '-700">' 
                    . ucfirst($priority) . 
                    '</span>';
            })
            ->addColumn('actions', function ($production) {
                return view('admin.produksi.produksi.partials.actions', compact('production'))->render();
            })
            ->rawColumns(['progress', 'status_badge', 'priority_badge', 'actions'])
            ->make(true);
    }

    /**
     * Calculate material cost for production
     */
    private function calculateMaterialCost($production)
    {
        $materialCost = 0;
        
        foreach ($production->materials as $material) {
            if ($material->material_type === 'bahan') {
                $bahan = Bahan::with('hargaBahan')->find($material->material_id);
                if ($bahan && $bahan->hargaBahan && $bahan->hargaBahan->isNotEmpty()) {
                    $hargaBahan = $bahan->hargaBahan->first();
                    $materialCost += $material->quantity_required * ($hargaBahan->harga_beli ?? 0);
                }
            } else {
                $produk = Produk::find($material->material_id);
                if ($produk && method_exists($produk, 'calculateHpp')) {
                    $materialCost += $material->quantity_required * ($produk->calculateHpp() ?? 0);
                }
            }
        }
        
        return $materialCost;
    }

    /**
     * Store new production
     */
    public function store(Request $request)
    {
        // Log request data for debugging
        Log::info('Production Store Request:', $request->all());
        
        $outletId = $this->getSelectedOutlet($request);
        Log::info('Selected Outlet ID:', ['outlet_id' => $outletId]);
        
        $validator = Validator::make($request->all(), [
            // Multi-product validation - either single product_id OR products array
            'product_id' => [
                'required_without:products',
                'integer',
                Rule::exists('produk', 'id_produk')->where(function ($query) use ($outletId) {
                    $query->where('id_outlet', $outletId);
                })
            ],
            // Multi-product support
            'products' => 'required_without:product_id|array|min:1',
            'products.*.product_id' => [
                'required_with:products',
                'integer',
                Rule::exists('produk', 'id_produk')->where(function ($query) use ($outletId) {
                    $query->where('id_outlet', $outletId);
                })
            ],
            'products.*.target_quantity' => 'required_with:products|integer|min:1',
            'products.*.sample_quantity' => 'nullable|integer|min:0',
            
            'production_line' => 'required|string|max:50',
            'target_quantity' => 'required|integer|min:1',
            'start_date' => 'required|date',
            'end_date' => 'required|date|after_or_equal:start_date',
            'priority' => 'nullable|in:normal,high,urgent',
            'max_reject_rate' => 'nullable|numeric|min:0|max:100',
            'min_efficiency' => 'nullable|numeric|min:0|max:100',
            'notes' => 'nullable|string',
            
            // Advanced production group
            'business_type' => 'nullable|string|in:tofu',
            'tofu_data' => 'nullable|array',
            'tofu_data.perendaman_waktu' => 'nullable|numeric|min:0',
            'tofu_data.perendaman_qty' => 'nullable|numeric|min:0',
            'tofu_data.rijek_telur' => 'nullable|integer|min:0',
            'tofu_data.pasteurisasi_waktu' => 'nullable|integer|min:0',
            'tofu_data.pasteurisasi_suhu' => 'nullable|integer|min:0',
            'tofu_data.berat_sari_kedelai' => 'nullable|numeric|min:0',
            'tofu_data.waktu_pencampuran' => 'nullable|integer|min:0',
            'tofu_data.filling_waktu' => 'nullable|numeric|min:0',
            'tofu_data.filling_mesin1' => 'nullable|integer|min:0',
            'tofu_data.filling_mesin2' => 'nullable|integer|min:0',
            'tofu_data.filling_total' => 'nullable|integer|min:0',
            'tofu_data.rijek_mentah' => 'nullable|integer|min:0',
            
            'materials' => 'nullable|array',
            'materials.*.material_id' => 'required_with:materials|integer',
            'materials.*.material_type' => 'required_with:materials|in:bahan,produk',
            'materials.*.quantity' => 'required_with:materials|numeric|min:0',
            'materials.*.unit' => 'required_with:materials|string',
            // Labor cost validation
            'labor_costs' => 'nullable|array',
            'labor_costs.worker_count' => 'nullable|integer|min:0',
            'labor_costs.cost_per_worker' => 'nullable|numeric|min:0',
            'labor_costs.from_attendance' => 'nullable|boolean',
            'labor_costs.attendance_date' => 'nullable|date',
            'labor_costs.notes' => 'nullable|string',
            // Operational costs validation
            'operational_costs' => 'nullable|array',
            'operational_costs.*.description' => 'nullable|string',
            'operational_costs.*.amount' => 'nullable|numeric|min:0',
            // Additional fields
            'expiry_date' => 'nullable|date|after_or_equal:start_date',
            'warehouse_location' => 'nullable|string|max:255',
        ]);

        if ($validator->fails()) {
            Log::error('Production Validation Failed:', $validator->errors()->toArray());
            return response()->json([
                'success' => false,
                'message' => 'Validasi gagal',
                'errors' => $validator->errors()
            ], 422);
        }

        try {
            DB::beginTransaction();

            $outletId = $this->getSelectedOutlet($request);
            
            // Generate production code
            $productionCode = Production::generateCode($outletId);

            // Calculate labor cost
            $totalLaborCost = 0;
            if ($request->filled('labor_costs.worker_count') && $request->filled('labor_costs.cost_per_worker')) {
                $totalLaborCost = $request->input('labor_costs.worker_count') * $request->input('labor_costs.cost_per_worker');
            }

            // Calculate operational cost
            $totalOperationalCost = 0;
            if ($request->filled('operational_costs')) {
                foreach ($request->operational_costs as $opCost) {
                    if (!empty($opCost['amount'])) {
                        $totalOperationalCost += $opCost['amount'];
                    }
                }
            }

            // Calculate material cost using FIFO method
            $materialCost = 0;
            if ($request->filled('materials')) {
                foreach ($request->materials as $material) {
                    if (!empty($material['material_id']) && !empty($material['quantity'])) {
                        $materialId = $material['material_id'];
                        $requiredQty = floatval($material['quantity']);
                        $materialType = $material['material_type'] ?? 'bahan';
                        
                        if ($materialType === 'bahan') {
                            $bahan = Bahan::with(['hargaBahan' => function($query) {
                                $query->where('stok', '>', 0)->orderBy('created_at', 'asc');
                            }])->find($materialId);
                            
                            if ($bahan && $bahan->hargaBahan->count() > 0) {
                                $sisaKebutuhan = $requiredQty;
                                $totalCostForMaterial = 0;
                                
                                foreach ($bahan->hargaBahan as $hargaBahan) {
                                    if ($sisaKebutuhan <= 0) break;
                                    
                                    $availableStock = $hargaBahan->stok;
                                    $usedQty = min($sisaKebutuhan, $availableStock);
                                    $costForThisBatch = $usedQty * $hargaBahan->harga_beli;
                                    
                                    $totalCostForMaterial += $costForThisBatch;
                                    $sisaKebutuhan -= $usedQty;
                                }
                                
                                $materialCost += $totalCostForMaterial;
                            }
                        }
                    }
                }
            }

            // Handle multi-product or single product
            $products = [];
            $totalTargetQuantity = 0;
            
            if ($request->filled('products')) {
                // Multi-product mode
                $products = $request->products;
                foreach ($products as $product) {
                    $totalTargetQuantity += $product['target_quantity'];
                }
            } else {
                // Single product mode (backward compatibility)
                $products = [[
                    'product_id' => $request->product_id,
                    'target_quantity' => $request->target_quantity,
                    'sample_quantity' => 0
                ]];
                $totalTargetQuantity = $request->target_quantity;
            }

            // Calculate total cost and HPP per unit
            $totalCost = $materialCost + $totalLaborCost + $totalOperationalCost;
            $hppPerUnit = $totalTargetQuantity > 0 ? $totalCost / $totalTargetQuantity : 0;

            // For multi-product, use the first product as the main product for the production record
            $mainProduct = $products[0];

            // Create production
            $production = Production::create([
                'production_code' => $productionCode,
                'outlet_id' => $outletId,
                'product_id' => $mainProduct['product_id'], // Main product for backward compatibility
                'production_line' => $request->production_line,
                'target_quantity' => $totalTargetQuantity, // Total quantity from all products
                'start_date' => $request->start_date,
                'end_date' => $request->end_date,
                'status' => 'draft',
                'priority' => $request->priority ?? 'normal',
                'max_reject_rate' => $request->max_reject_rate ?? 3.00,
                'min_efficiency' => $request->min_efficiency ?? 85.00,
                'notes' => $request->notes,
                'material_cost' => $materialCost,
                'labor_cost' => $totalLaborCost,
                'operational_cost' => $totalOperationalCost,
                'total_cost' => $totalCost,
                'hpp_per_unit' => $hppPerUnit,
                'expiry_date' => $request->expiry_date,
                'warehouse_location' => $request->warehouse_location,
                'business_type' => $request->business_type,
                'tofu_data' => $request->business_type === 'tofu' ? json_encode($request->tofu_data) : null,
                'created_by' => auth()->id(),
            ]);

            // Create HPP records for each product
            foreach ($products as $productData) {
                HppProduk::create([
                    'id_produk' => $productData['product_id'],
                    'hpp' => $hppPerUnit, // Same HPP for all products
                    'stok' => 0, // Initial stock is 0, will be updated during realization
                    'production_id' => $production->id,
                    'target_quantity' => $productData['target_quantity'],
                    'sample_quantity' => $productData['sample_quantity'] ?? 0,
                ]);
            }

            // Add materials if provided
            if ($request->filled('materials')) {
                foreach ($request->materials as $material) {
                    if (!empty($material['material_id']) && !empty($material['quantity'])) {
                        ProductionMaterial::create([
                            'production_id' => $production->id,
                            'material_id' => $material['material_id'],
                            'material_type' => $material['material_type'] ?? 'bahan',
                            'quantity_required' => $material['quantity'],
                            'unit' => $material['unit'] ?? 'pcs',
                        ]);
                    }
                }
            }

            // Add labor costs if provided
            if ($request->filled('labor_costs.worker_count') && $request->filled('labor_costs.cost_per_worker')) {
                ProductionLaborCost::create([
                    'production_id' => $production->id,
                    'worker_count' => $request->input('labor_costs.worker_count'),
                    'cost_per_worker' => $request->input('labor_costs.cost_per_worker'),
                    'total_cost' => $totalLaborCost,
                    'from_attendance' => $request->input('labor_costs.from_attendance', false),
                    'attendance_date' => $request->input('labor_costs.attendance_date'),
                    'notes' => $request->input('labor_costs.notes'),
                ]);
            }

            // Add operational costs if provided
            if ($request->filled('operational_costs')) {
                foreach ($request->operational_costs as $opCost) {
                    if (!empty($opCost['description']) && !empty($opCost['amount'])) {
                        ProductionOperationalCost::create([
                            'production_id' => $production->id,
                            'cost_type' => $opCost['description'], // Use description as cost_type
                            'amount' => $opCost['amount'],
                            'description' => $opCost['description'] ?? null,
                        ]);
                    }
                }
            }

            DB::commit();

            return response()->json([
                'success' => true,
                'message' => 'Produksi berhasil dibuat',
                'data' => $production
            ]);

        } catch (\Exception $e) {
            DB::rollBack();
            Log::error('Error creating production: ' . $e->getMessage());
            
            return response()->json([
                'success' => false,
                'message' => 'Gagal membuat produksi: ' . $e->getMessage()
            ], 500);
        }
    }

    /**
     * Show production detail
     */
    public function show($id)
    {
        // Add detailed logging for debugging
        Log::info('Production Show Method Called', [
            'id' => $id,
            'request_url' => request()->fullUrl(),
            'request_method' => request()->method(),
            'user_id' => auth()->id(),
            'ip' => request()->ip()
        ]);

        try {
            // Check if production exists first
            $productionExists = Production::where('id', $id)->exists();
            Log::info('Production Existence Check', [
                'id' => $id,
                'exists' => $productionExists
            ]);

            if (!$productionExists) {
                Log::warning('Production Not Found', ['id' => $id]);
                return response()->json([
                    'success' => false,
                    'message' => 'Produksi tidak ditemukan'
                ], 404);
            }

            $production = Production::with([
                'product.hppProduk', 
                'materials', // Load materials without the material relationship first
                'laborCosts',
                'operationalCosts',
                'realizations', 
                'creator', 
                'approver',
                'outlet',
                'hppRecords.product' // Load HPP records with product relationship
            ])->findOrFail($id);

            // Manually load the material relationships based on type
            foreach ($production->materials as $material) {
                Log::info('Loading material', [
                    'material_id' => $material->material_id,
                    'material_type' => $material->material_type
                ]);
                
                if ($material->material_type === 'bahan') {
                    // Load Bahan with hargaBahan (correct relationship name)
                    $bahan = Bahan::with('hargaBahan')->find($material->material_id);
                    $material->setRelation('material', $bahan);
                    Log::info('Loaded Bahan', ['bahan_id' => $material->material_id, 'found' => $bahan ? true : false]);
                } else {
                    // Load Produk without harga_bahan
                    $produk = Produk::find($material->material_id);
                    $material->setRelation('material', $produk);
                    Log::info('Loaded Produk', ['produk_id' => $material->material_id, 'found' => $produk ? true : false]);
                }
            }

            Log::info('Production Data Loaded Successfully', [
                'id' => $id,
                'production_code' => $production->production_code,
                'product_id' => $production->product_id,
                'materials_count' => $production->materials->count(),
                'labor_costs_count' => $production->laborCosts->count(),
                'operational_costs_count' => $production->operationalCosts->count()
            ]);

            // Calculate product stock and HPP
            $productStock = $production->product->hppProduk->sum('stok');
            $productHpp = $production->product->calculateHpp();

            $data = $production->toArray();
            $data['product_stock'] = $productStock;
            $data['product_hpp'] = $productHpp;
            
            // Add HPP records for multi-product realization
            $data['hpp_records'] = $production->hppRecords->map(function($hppRecord) {
                return [
                    'id' => $hppRecord->id,
                    'product_id' => $hppRecord->id_produk,
                    'product' => $hppRecord->product ? [
                        'id_produk' => $hppRecord->product->id_produk,
                        'nama_produk' => $hppRecord->product->nama_produk ?? 'Unknown',
                        'kode_produk' => $hppRecord->product->kode_produk ?? 'No Code',
                    ] : null,
                    'target_quantity' => $hppRecord->target_quantity ?? 0,
                    'sample_quantity' => $hppRecord->sample_quantity ?? 0,
                    'realized_quantity' => $hppRecord->realized_quantity ?? 0,
                    'rejected_quantity' => $hppRecord->rejected_quantity ?? 0,
                    'hpp' => $hppRecord->hpp,
                    'stok' => $hppRecord->stok,
                ];
            });
            
            // Add HPP calculation
            $materialCost = $production->materials->sum(function($material) {
                if ($material->material_type === 'bahan') {
                    $bahan = $material->material;
                    if ($bahan && $bahan->hargaBahan && $bahan->hargaBahan->isNotEmpty()) {
                        $hargaBahan = $bahan->hargaBahan->first();
                        $cost = $material->quantity_required * ($hargaBahan->harga_beli ?? 0);
                        Log::info('Bahan cost calculation', [
                            'bahan_id' => $bahan->id_bahan,
                            'quantity_required' => $material->quantity_required,
                            'harga_beli' => $hargaBahan->harga_beli ?? 0,
                            'cost' => $cost
                        ]);
                        return $cost;
                    }
                    Log::info('Bahan cost zero', ['bahan_id' => $bahan->id_bahan ?? 'null']);
                    return 0;
                } else {
                    $produk = $material->material;
                    if ($produk && method_exists($produk, 'calculateHpp')) {
                        $cost = $material->quantity_required * ($produk->calculateHpp() ?? 0);
                        Log::info('Produk cost calculation', [
                            'produk_id' => $produk->id_produk ?? 0,
                            'quantity_required' => $material->quantity_required,
                            'hpp' => $produk->calculateHpp() ?? 0,
                            'cost' => $cost
                        ]);
                        return $cost;
                    }
                    Log::info('Produk cost zero', ['produk_id' => $produk->id_produk ?? 'null']);
                    return 0;
                }
            });
            
            $laborCost = $production->laborCosts->sum(function($labor) {
                return $labor->worker_count * $labor->cost_per_worker;
            });
            
            $operationalCost = $production->operationalCosts->sum('amount');
            $totalCost = $materialCost + $laborCost + $operationalCost;
            
            $data['hpp_calculation'] = [
                'material_cost' => $materialCost,
                'labor_cost' => $laborCost,
                'operational_cost' => $operationalCost,
                'total_cost' => $totalCost,
                'hpp_per_unit' => $production->target_quantity > 0 ? $totalCost / $production->target_quantity : 0
            ];
            
            // Format labor costs for display
            if ($production->laborCosts->isNotEmpty()) {
                $laborCostData = $production->laborCosts->first();
                $data['labor_costs'] = [
                    'worker_count' => $laborCostData->worker_count,
                    'cost_per_worker' => $laborCostData->cost_per_worker
                ];
            }

            Log::info('Production Show Response Prepared', [
                'id' => $id,
                'response_size' => strlen(json_encode($data))
            ]);

            return response()->json([
                'success' => true,
                'data' => $data
            ]);

        } catch (\Exception $e) {
            Log::error('Production Show Error', [
                'id' => $id,
                'error' => $e->getMessage(),
                'trace' => $e->getTraceAsString()
            ]);
            
            return response()->json([
                'success' => false,
                'message' => 'Produksi tidak ditemukan'
            ], 404);
        }
    }

    /**
     * Show edit form for production
     */
    public function edit($id)
    {
        try {
            $production = Production::with([
                'product',
                'materials.material',
                'laborCosts',
                'operationalCosts',
                'outlet'
            ])->findOrFail($id);

            // Only allow edit if status is draft
            if ($production->status !== 'draft') {
                return response()->json([
                    'success' => false,
                    'message' => 'Hanya produksi dengan status draft yang dapat diedit'
                ], 403);
            }

            // Load materials with proper relationships
            foreach ($production->materials as $material) {
                if ($material->material_type === 'bahan') {
                    $bahan = Bahan::with('satuan')->find($material->material_id);
                    $material->setRelation('material', $bahan);
                } else {
                    $produk = Produk::find($material->material_id);
                    $material->setRelation('material', $produk);
                }
            }

            return response()->json([
                'success' => true,
                'data' => $production
            ]);

        } catch (\Exception $e) {
            Log::error('Error getting production for edit: ' . $e->getMessage());
            
            return response()->json([
                'success' => false,
                'message' => 'Gagal memuat data produksi: ' . $e->getMessage()
            ], 500);
        }
    }

    /**
     * Update production
     */
    public function update(Request $request, $id)
    {
        $validator = Validator::make($request->all(), [
            'product_id' => 'required|exists:produk,id_produk',
            'production_line' => 'required|string|max:50',
            'target_quantity' => 'required|integer|min:1',
            'start_date' => 'required|date',
            'end_date' => 'required|date|after_or_equal:start_date',
            'priority' => 'nullable|in:normal,high,urgent',
            'max_reject_rate' => 'nullable|numeric|min:0|max:100',
            'min_efficiency' => 'nullable|numeric|min:0|max:100',
            'notes' => 'nullable|string',
            'expiry_date' => 'nullable|date',
            'warehouse_location' => 'nullable|string|max:255',
            'materials' => 'nullable|array',
            'materials.*.material_id' => 'required_with:materials|integer',
            'materials.*.material_type' => 'required_with:materials|in:bahan,produk',
            'materials.*.quantity' => 'required_with:materials|numeric|min:0.01',
            'labor_costs' => 'nullable|array',
            'labor_costs.worker_count' => 'nullable|integer|min:0',
            'labor_costs.cost_per_worker' => 'nullable|numeric|min:0',
            'labor_costs.notes' => 'nullable|string',
            'operational_costs' => 'nullable|array',
            'operational_costs.*.description' => 'required_with:operational_costs|string',
            'operational_costs.*.amount' => 'required_with:operational_costs|numeric|min:0',
        ]);

        if ($validator->fails()) {
            return response()->json([
                'success' => false,
                'message' => 'Validasi gagal',
                'errors' => $validator->errors()
            ], 422);
        }

        try {
            DB::beginTransaction();
            
            $production = Production::findOrFail($id);

            // Only allow update if status is draft
            if ($production->status !== 'draft') {
                return response()->json([
                    'success' => false,
                    'message' => 'Hanya produksi dengan status draft yang dapat diubah'
                ], 403);
            }

            // Update basic production data
            $production->update([
                'product_id' => $request->product_id,
                'production_line' => $request->production_line,
                'target_quantity' => $request->target_quantity,
                'start_date' => $request->start_date,
                'end_date' => $request->end_date,
                'expiry_date' => $request->expiry_date,
                'warehouse_location' => $request->warehouse_location,
                'priority' => $request->priority ?? 'normal',
                'max_reject_rate' => $request->max_reject_rate ?? 3.00,
                'min_efficiency' => $request->min_efficiency ?? 85.00,
                'notes' => $request->notes,
            ]);

            // Update materials
            if ($request->has('materials')) {
                // Delete existing materials
                $production->materials()->delete();
                
                // Add new materials
                foreach ($request->materials as $materialData) {
                    if (!empty($materialData['material_id'])) {
                        // Get unit from material data with logging
                        $unit = 'pcs'; // Default fallback
                        
                        Log::info('Getting unit for material', [
                            'material_id' => $materialData['material_id'],
                            'material_type' => $materialData['material_type']
                        ]);
                        
                        if ($materialData['material_type'] === 'bahan') {
                            $bahan = Bahan::with('satuan')->find($materialData['material_id']);
                            if ($bahan && $bahan->satuan) {
                                $unit = $bahan->satuan->nama_satuan ?? $bahan->satuan->simbol ?? 'kg';
                                Log::info('Bahan unit found from satuan', [
                                    'bahan_id' => $bahan->id_bahan,
                                    'satuan_id' => $bahan->id_satuan,
                                    'unit' => $unit
                                ]);
                            } else {
                                Log::warning('Bahan or satuan not found', [
                                    'material_id' => $materialData['material_id'],
                                    'bahan_found' => !!$bahan,
                                    'satuan_found' => $bahan ? !!$bahan->satuan : false
                                ]);
                                $unit = 'kg'; // Default for bahan
                            }
                        } else {
                            $produk = Produk::find($materialData['material_id']);
                            if ($produk) {
                                // Try different possible unit field names for produk
                                $unit = $produk->unit ?? $produk->satuan ?? $produk->nama_satuan ?? 'pcs';
                                Log::info('Produk unit found', [
                                    'produk_id' => $produk->id_produk ?? $produk->id,
                                    'unit' => $unit
                                ]);
                            } else {
                                Log::warning('Produk not found', ['material_id' => $materialData['material_id']]);
                                $unit = 'pcs'; // Default for produk
                            }
                        }
                        
                        // Ensure unit is never null or empty
                        if (empty($unit)) {
                            $unit = $materialData['material_type'] === 'bahan' ? 'kg' : 'pcs';
                        }
                        
                        Log::info('Final unit for material', [
                            'material_id' => $materialData['material_id'],
                            'final_unit' => $unit
                        ]);
                        
                        $production->materials()->create([
                            'material_id' => $materialData['material_id'],
                            'material_type' => $materialData['material_type'] ?? 'bahan',
                            'quantity_required' => $materialData['quantity'],
                            'unit' => $unit,
                        ]);
                    }
                }
            }

            // Update labor costs
            if ($request->has('labor_costs')) {
                // Delete existing labor costs
                $production->laborCosts()->delete();
                
                // Add new labor cost if data provided
                $laborData = $request->labor_costs;
                if (!empty($laborData['worker_count']) && !empty($laborData['cost_per_worker'])) {
                    $workerCount = (int) $laborData['worker_count'];
                    $costPerWorker = (float) $laborData['cost_per_worker'];
                    $totalCost = $workerCount * $costPerWorker;
                    
                    $production->laborCosts()->create([
                        'worker_count' => $workerCount,
                        'cost_per_worker' => $costPerWorker,
                        'total_cost' => $totalCost,
                        'notes' => $laborData['notes'] ?? null,
                    ]);
                }
            }

            // Update operational costs
            if ($request->has('operational_costs')) {
                // Delete existing operational costs
                $production->operationalCosts()->delete();
                
                // Add new operational costs
                foreach ($request->operational_costs as $costData) {
                    if (!empty($costData['description']) && !empty($costData['amount'])) {
                        $production->operationalCosts()->create([
                            'cost_type' => $costData['description'], // Use description as cost_type
                            'amount' => $costData['amount'],
                            'description' => $costData['description'] ?? null,
                        ]);
                    }
                }
            }

            DB::commit();

            return response()->json([
                'success' => true,
                'message' => 'Produksi berhasil diperbarui',
                'data' => $production->load(['materials', 'laborCosts', 'operationalCosts'])
            ]);

        } catch (\Exception $e) {
            DB::rollBack();
            Log::error('Error updating production: ' . $e->getMessage());
            Log::error($e->getTraceAsString());
            
            return response()->json([
                'success' => false,
                'message' => 'Gagal memperbarui produksi: ' . $e->getMessage()
            ], 500);
        }
    }

    /**
     * Delete production
     */
    public function destroy($id)
    {
        try {
            $production = Production::findOrFail($id);

            // Only allow delete if status is draft or cancelled
            if (!in_array($production->status, ['draft', 'cancelled'])) {
                return response()->json([
                    'success' => false,
                    'message' => 'Hanya produksi dengan status draft atau dibatalkan yang dapat dihapus'
                ], 403);
            }

            $production->delete();

            return response()->json([
                'success' => true,
                'message' => 'Produksi berhasil dihapus'
            ]);

        } catch (\Exception $e) {
            Log::error('Error deleting production: ' . $e->getMessage());
            
            return response()->json([
                'success' => false,
                'message' => 'Gagal menghapus produksi: ' . $e->getMessage()
            ], 500);
        }
    }

    /**
     * Approve production
     */
    public function approve($id)
    {
        try {
            $production = Production::findOrFail($id);

            if ($production->status !== 'draft') {
                return response()->json([
                    'success' => false,
                    'message' => 'Hanya produksi dengan status draft yang dapat disetujui'
                ], 403);
            }

            $production->approve(auth()->id());

            return response()->json([
                'success' => true,
                'message' => 'Produksi berhasil disetujui'
            ]);

        } catch (\Exception $e) {
            Log::error('Error approving production: ' . $e->getMessage());
            
            return response()->json([
                'success' => false,
                'message' => 'Gagal menyetujui produksi: ' . $e->getMessage()
            ], 500);
        }
    }

    /**
     * Start production
     */
    public function start($id)
    {
        try {
            $production = Production::findOrFail($id);

            if ($production->status !== 'approved') {
                return response()->json([
                    'success' => false,
                    'message' => 'Hanya produksi yang sudah disetujui yang dapat dimulai'
                ], 403);
            }

            $production->start();

            return response()->json([
                'success' => true,
                'message' => 'Produksi berhasil dimulai'
            ]);

        } catch (\Exception $e) {
            Log::error('Error starting production: ' . $e->getMessage());
            
            return response()->json([
                'success' => false,
                'message' => 'Gagal memulai produksi: ' . $e->getMessage()
            ], 500);
        }
    }

    /**
     * Cancel production
     */
    public function cancel($id)
    {
        try {
            $production = Production::findOrFail($id);

            if (in_array($production->status, ['completed', 'cancelled'])) {
                return response()->json([
                    'success' => false,
                    'message' => 'Produksi yang sudah selesai atau dibatalkan tidak dapat dibatalkan lagi'
                ], 403);
            }

            $production->cancel();

            return response()->json([
                'success' => true,
                'message' => 'Produksi berhasil dibatalkan'
            ]);

        } catch (\Exception $e) {
            Log::error('Error cancelling production: ' . $e->getMessage());
            
            return response()->json([
                'success' => false,
                'message' => 'Gagal membatalkan produksi: ' . $e->getMessage()
            ], 500);
        }
    }

    /**
     * Complete production
     */
    public function complete($id)
    {
        try {
            $production = Production::findOrFail($id);

            if ($production->status !== 'in_progress') {
                return response()->json([
                    'success' => false,
                    'message' => 'Hanya produksi yang sedang berjalan yang dapat diselesaikan'
                ], 403);
            }

            // Allow manual completion regardless of progress percentage
            $production->complete();

            return response()->json([
                'success' => true,
                'message' => 'Produksi berhasil diselesaikan'
            ]);

        } catch (\Exception $e) {
            Log::error('Error completing production: ' . $e->getMessage());
            
            return response()->json([
                'success' => false,
                'message' => 'Gagal menyelesaikan produksi: ' . $e->getMessage()
            ], 500);
        }
    }

    /**
     * Add realization with multi-product support
     */
    public function addRealization(Request $request, $id)
    {
        // Check if this is multi-product realization
        if ($request->has('products') && is_array($request->products)) {
            return $this->addMultiProductRealization($request, $id);
        }
        
        // Legacy single product realization (backward compatibility)
        return $this->addSingleProductRealization($request, $id);
    }

    /**
     * Add multi-product realization
     */
    private function addMultiProductRealization(Request $request, $id)
    {
        // Log request data for debugging
        Log::info('Multi-Product Realization Request', [
            'production_id' => $id,
            'request_data' => $request->all(),
            'products_count' => is_array($request->products) ? count($request->products) : 0
        ]);

        $validator = Validator::make($request->all(), [
            'products' => 'required|array|min:1',
            'products.*.product_id' => 'required|integer|exists:produk,id_produk',
            'products.*.hpp_record_id' => 'required|integer|exists:hpp_produk,id',
            'products.*.quantity_produced' => 'required|integer|min:1',
            'products.*.quantity_rejected' => 'nullable|integer|min:0',
            'products.*.notes' => 'nullable|string|max:255',
            'notes' => 'nullable|string|max:1000', // Global notes
        ]);

        if ($validator->fails()) {
            Log::error('Multi-Product Realization Validation Failed', [
                'production_id' => $id,
                'errors' => $validator->errors()->toArray(),
                'request_data' => $request->all()
            ]);
            
            return response()->json([
                'success' => false,
                'message' => 'Validasi gagal',
                'errors' => $validator->errors()
            ], 422);
        }

        try {
            DB::beginTransaction();

            $production = Production::with('materials')->findOrFail($id);

            if ($production->status !== 'in_progress') {
                return response()->json([
                    'success' => false,
                    'message' => 'Hanya produksi yang sedang berjalan yang dapat ditambahkan realisasi'
                ], 403);
            }

            $totalProduced = 0;
            $totalRejected = 0;
            $realizationDetails = [];

            // Process each product realization
            foreach ($request->products as $productData) {
                $quantityProduced = $productData['quantity_produced'] ?? 0;
                $quantityRejected = $productData['quantity_rejected'] ?? 0;
                
                if ($quantityProduced <= 0) continue; // Skip if no production
                
                $totalProduced += $quantityProduced;
                $totalRejected += $quantityRejected;

                // Update HPP record stock
                $hppRecord = HppProduk::find($productData['hpp_record_id']);
                if ($hppRecord) {
                    $hppRecord->stok += $quantityProduced;
                    $hppRecord->realized_quantity = ($hppRecord->realized_quantity ?? 0) + $quantityProduced;
                    $hppRecord->rejected_quantity = ($hppRecord->rejected_quantity ?? 0) + $quantityRejected;
                    $hppRecord->save();
                }

                $realizationDetails[] = [
                    'product_id' => $productData['product_id'],
                    'hpp_record_id' => $productData['hpp_record_id'],
                    'quantity_produced' => $quantityProduced,
                    'quantity_rejected' => $quantityRejected,
                    'notes' => $productData['notes'] ?? null,
                ];
            }

            if ($totalProduced <= 0) {
                return response()->json([
                    'success' => false,
                    'message' => 'Minimal harus ada satu produk yang diproduksi'
                ], 400);
            }

            // Validate and reduce material stock proportionally
            $totalMaterialCost = $this->processMaterialStock($production, $totalProduced);

            // Create realization record
            $realization = ProductionRealization::create([
                'production_id' => $production->id,
                'quantity_produced' => $totalProduced,
                'quantity_rejected' => $totalRejected,
                'material_cost' => $totalMaterialCost,
                'notes' => $request->notes,
                'realization_details' => json_encode($realizationDetails),
                'created_by' => auth()->id(),
            ]);

            // Update production realized quantity
            $production->realized_quantity += $totalProduced;
            $production->save();

            DB::commit();

            return response()->json([
                'success' => true,
                'message' => 'Realisasi berhasil ditambahkan',
                'data' => [
                    'realization' => $realization,
                    'total_produced' => $totalProduced,
                    'total_rejected' => $totalRejected,
                    'products_count' => count($realizationDetails)
                ]
            ]);

        } catch (\Exception $e) {
            DB::rollBack();
            Log::error('Error adding multi-product realization: ' . $e->getMessage());
            
            return response()->json([
                'success' => false,
                'message' => 'Gagal menambahkan realisasi: ' . $e->getMessage()
            ], 500);
        }
    }

    /**
     * Legacy single product realization (backward compatibility)
     */
    private function addSingleProductRealization(Request $request, $id)
    {
        $validator = Validator::make($request->all(), [
            'quantity_produced' => 'required|integer|min:1',
            'quantity_rejected' => 'nullable|integer|min:0',
            'notes' => 'nullable|string',
        ]);

        if ($validator->fails()) {
            return response()->json([
                'success' => false,
                'message' => 'Validasi gagal',
                'errors' => $validator->errors()
            ], 422);
        }

        try {
            DB::beginTransaction();

            $production = Production::with('materials')->findOrFail($id);

            if ($production->status !== 'in_progress') {
                return response()->json([
                    'success' => false,
                    'message' => 'Hanya produksi yang sedang berjalan yang dapat ditambahkan realisasi'
                ], 403);
            }

            // Validate and reduce material stock
            $totalMaterialCost = $this->processMaterialStock($production, $request->quantity_produced);

            // Add realization record
            $realization = $production->addRealization(
                $request->quantity_produced,
                $request->quantity_rejected ?? 0,
                $request->notes
            );

            // Use HPP per unit from production (already calculated when production was created)
            $hppPerUnit = $production->hpp_per_unit ?? 0;

            // Update product stock in hpp_produk table based on production_id
            $hppProduk = HppProduk::where('production_id', $production->id)->first();
            
            if ($hppProduk) {
                // Update existing record: add to stock (HPP remains same from production)
                $hppProduk->stok += $request->quantity_produced;
                $hppProduk->save();
            } else {
                // Create new record if not exists (should not happen if production was created properly)
                HppProduk::create([
                    'id_produk' => $production->product_id,
                    'hpp' => $hppPerUnit,
                    'stok' => $request->quantity_produced,
                    'production_id' => $production->id,
                ]);
            }

            DB::commit();

            return response()->json([
                'success' => true,
                'message' => 'Realisasi berhasil ditambahkan',
                'data' => $realization
            ]);

        } catch (\Exception $e) {
            DB::rollBack();
            Log::error('Error adding realization: ' . $e->getMessage());
            
            return response()->json([
                'success' => false,
                'message' => 'Gagal menambahkan realisasi: ' . $e->getMessage()
            ], 500);
        }
    }

    /**
     * Process material stock reduction with FIFO method
     */
    private function processMaterialStock($production, $quantityProduced)
    {
        $totalMaterialCost = 0;

        // Validate stock availability for all materials
        foreach ($production->materials as $material) {
            $bahan = Bahan::with('hargaBahan')->find($material->material_id);
            if (!$bahan) continue;
            
            $totalStok = $bahan->hargaBahan->sum('stok');
            
            // Calculate required quantity based on production ratio
            $ratio = $quantityProduced / $production->target_quantity;
            $requiredQty = $material->quantity_required * $ratio;
            
            if ($totalStok < $requiredQty) {
                throw new \Exception("Stok {$bahan->nama_bahan} tidak mencukupi. Tersedia: {$totalStok} {$material->unit}, Dibutuhkan: {$requiredQty} {$material->unit} untuk {$quantityProduced} unit produk. Silahkan lakukan pembelian bahan di menu PO.");
            }
        }

        // Reduce material stock using FIFO method
        foreach ($production->materials as $material) {
            $bahan = Bahan::with('hargaBahan')->find($material->material_id);
            if (!$bahan) continue;
            
            // Calculate required quantity based on production ratio
            $ratio = $quantityProduced / $production->target_quantity;
            $requiredQty = $material->quantity_required * $ratio;
            
            // Reduce stock using FIFO method
            $sisaKurang = $requiredQty;
            $materialCost = 0;
            
            $bahanDetails = $bahan->hargaBahan()
                ->where('stok', '>', 0)
                ->orderBy('created_at', 'asc')
                ->get();

            foreach ($bahanDetails as $detail) {
                if ($sisaKurang <= 0) break;

                if ($detail->stok >= $sisaKurang) {
                    $materialCost += $detail->harga_beli * $sisaKurang;
                    $detail->stok -= $sisaKurang;
                    $detail->save();
                    $sisaKurang = 0;
                } else {
                    $materialCost += $detail->harga_beli * $detail->stok;
                    $sisaKurang -= $detail->stok;
                    $detail->stok = 0;
                    $detail->save();
                }
            }
            
            $totalMaterialCost += $materialCost;
        }

        return $totalMaterialCost;
    }

    /**
     * Get products for autocomplete search
     */
    public function getProducts(Request $request)
    {
        $outletId = $this->getSelectedOutlet($request);
        $search = $request->get('search', '');
        
        $query = Produk::select('id_produk', 'kode_produk', 'nama_produk', 'harga_jual')
            ->where('id_outlet', $outletId)
            ->where('is_active', true);
        
        if ($search) {
            $query->where(function($q) use ($search) {
                $q->where('kode_produk', 'like', "%{$search}%")
                  ->orWhere('nama_produk', 'like', "%{$search}%");
            });
        }
        
        $products = $query->limit(10)
            ->get()
            ->map(function($product) {
                return [
                    'id' => $product->id_produk,
                    'code' => $product->kode_produk ?? 'No Code',
                    'name' => $product->nama_produk ?? 'Unknown Product',
                    'price' => $product->harga_jual,
                    'stock' => $product->stok ?? 0,
                    'hpp' => $product->calculateHpp(),
                ];
            });

        return response()->json([
            'success' => true,
            'data' => $products
        ]);
    }

    /**
     * Get materials (only bahan) with stock info
     */
    public function getMaterials(Request $request)
    {
        $outletId = $this->getSelectedOutlet($request);
        
        // Only get bahan (not produk) with stock information
        $bahan = Bahan::select('id_bahan', 'nama_bahan', 'id_satuan')
            ->with(['satuan:id_satuan,nama_satuan', 'hargaBahan'])
            ->where('id_outlet', $outletId)
            ->where('is_active', true)
            ->get()
            ->map(function($item) {
                $totalStok = $item->hargaBahan->sum('stok');
                return [
                    'id' => $item->id_bahan,
                    'name' => $item->nama_bahan,
                    'type' => 'bahan',
                    'unit' => $item->satuan ? $item->satuan->nama_satuan : 'kg',
                    'stock' => $totalStok,
                ];
            });

        return response()->json([
            'success' => true,
            'data' => $bahan
        ]);
    }

    /**
     * Get material FIFO information
     */
    public function getMaterialFifo(Request $request, $id)
    {
        try {
            $quantity = floatval($request->get('quantity', 0));
            $outletId = $this->getSelectedOutlet($request);
            
            if ($quantity <= 0) {
                return response()->json([
                    'success' => false,
                    'message' => 'Quantity harus lebih dari 0'
                ], 400);
            }
            
            $bahan = Bahan::with(['hargaBahan' => function($query) {
                $query->where('stok', '>', 0)->orderBy('created_at', 'asc');
            }, 'satuan'])->find($id);
            
            if (!$bahan) {
                return response()->json([
                    'success' => false,
                    'message' => 'Material tidak ditemukan'
                ], 404);
            }
            
            $sisaKebutuhan = $quantity;
            $totalCost = 0;
            $fifoDetails = [];
            
            foreach ($bahan->hargaBahan as $hargaBahan) {
                if ($sisaKebutuhan <= 0) break;
                
                $availableStock = $hargaBahan->stok;
                $usedQty = min($sisaKebutuhan, $availableStock);
                $costForThisBatch = $usedQty * $hargaBahan->harga_beli;
                
                $totalCost += $costForThisBatch;
                $sisaKebutuhan -= $usedQty;
                
                $fifoDetails[] = [
                    'qty' => $usedQty,
                    'price' => $hargaBahan->harga_beli,
                    'cost' => $costForThisBatch,
                    'date' => $hargaBahan->created_at->format('d/m/Y'),
                    'batch_id' => $hargaBahan->id
                ];
            }
            
            $avgPrice = $quantity > 0 ? $totalCost / $quantity : 0;
            $sufficientStock = $sisaKebutuhan <= 0;
            
            return response()->json([
                'success' => true,
                'data' => [
                    'material_name' => $bahan->nama_bahan,
                    'required_qty' => $quantity,
                    'unit' => $bahan->satuan ? $bahan->satuan->nama_satuan : 'kg',
                    'total_cost' => $totalCost,
                    'avg_price' => $avgPrice,
                    'fifo_details' => $fifoDetails,
                    'sufficient_stock' => $sufficientStock,
                    'remaining_need' => max(0, $sisaKebutuhan)
                ]
            ]);
            
        } catch (\Exception $e) {
            Log::error('Error getting material FIFO info: ' . $e->getMessage());
            
            return response()->json([
                'success' => false,
                'message' => 'Gagal memuat informasi FIFO: ' . $e->getMessage()
            ], 500);
        }
    }

    /**
     * Get statistics
     */
    public function getStatistics(Request $request)
    {
        $outletId = $this->getSelectedOutlet($request);
        
        $stats = [
            'active' => Production::where('outlet_id', $outletId)
                ->whereIn('status', ['approved', 'in_progress'])
                ->count(),
            'draft' => Production::where('outlet_id', $outletId)
                ->where('status', 'draft')
                ->count(),
            'in_progress' => Production::where('outlet_id', $outletId)
                ->where('status', 'in_progress')
                ->count(),
            'completed' => Production::where('outlet_id', $outletId)
                ->where('status', 'completed')
                ->count(),
            'total' => Production::where('outlet_id', $outletId)->count(),
        ];

        return response()->json([
            'success' => true,
            'data' => $stats
        ]);
    }

    /**
     * Get attendance count for specific date
     */
    public function getAttendanceCount(Request $request)
    {
        $validator = Validator::make($request->all(), [
            'date' => 'required|date',
        ]);

        if ($validator->fails()) {
            return response()->json([
                'success' => false,
                'message' => 'Tanggal tidak valid',
                'errors' => $validator->errors()
            ], 422);
        }

        try {
            $outletId = $this->getSelectedOutlet($request);
            $date = $request->date;
            
            Log::info('Getting attendance count', [
                'date' => $date,
                'outlet_id' => $outletId
            ]);
            
            // Count attendance for the specific date and outlet
            $attendanceCount = Attendance::where('outlet_id', $outletId)
                ->where('date', $date)
                ->where('status', 'present') // Fix: use 'present' instead of 'hadir'
                ->count();
                
            // Also get detailed attendance data for debugging
            $attendanceDetails = Attendance::where('outlet_id', $outletId)
                ->where('date', $date)
                ->select('employee_name', 'status', 'clock_in', 'clock_out')
                ->get();
                
            Log::info('Attendance query result', [
                'count' => $attendanceCount,
                'details' => $attendanceDetails->toArray()
            ]);

            return response()->json([
                'success' => true,
                'data' => [
                    'count' => $attendanceCount,
                    'date' => $date,
                    'outlet_id' => $outletId,
                    'details' => $attendanceDetails // For debugging
                ]
            ]);

        } catch (\Exception $e) {
            Log::error('Error getting attendance count: ' . $e->getMessage());
            Log::error($e->getTraceAsString());
            
            return response()->json([
                'success' => false,
                'message' => 'Gagal mengambil data absensi: ' . $e->getMessage()
            ], 500);
        }
    }

    /**
     * Calculate HPP preview
     */
    public function calculateHppPreview(Request $request)
    {
        try {
            Log::info('🧮 [HPP PREVIEW] Starting calculation', [
                'request_data' => $request->all(),
                'user_id' => auth()->id()
            ]);
            
            $outletId = $this->getSelectedOutlet($request);
            $materialCost = 0;
            $laborCost = 0;
            $operationalCost = 0;
            $materialDetails = [];
            $operationalDetails = [];
            
            Log::info('🏢 [HPP PREVIEW] Using outlet:', ['outlet_id' => $outletId]);
            
            // Calculate material cost using FIFO method
            if ($request->filled('materials')) {
                foreach ($request->materials as $material) {
                    if (!empty($material['material_id']) && !empty($material['quantity'])) {
                        $materialId = $material['material_id'];
                        $requiredQty = floatval($material['quantity']);
                        $materialType = $material['material_type'] ?? 'bahan';
                        
                        if ($materialType === 'bahan') {
                            $bahan = Bahan::with(['hargaBahan' => function($query) {
                                $query->where('stok', '>', 0)->orderBy('created_at', 'asc');
                            }, 'satuan'])->find($materialId);
                            
                            if ($bahan && $bahan->hargaBahan->count() > 0) {
                                $sisaKebutuhan = $requiredQty;
                                $totalCostForMaterial = 0;
                                $fifoDetails = [];
                                
                                foreach ($bahan->hargaBahan as $hargaBahan) {
                                    if ($sisaKebutuhan <= 0) break;
                                    
                                    $availableStock = $hargaBahan->stok;
                                    $usedQty = min($sisaKebutuhan, $availableStock);
                                    $costForThisBatch = $usedQty * $hargaBahan->harga_beli;
                                    
                                    $totalCostForMaterial += $costForThisBatch;
                                    $sisaKebutuhan -= $usedQty;
                                    
                                    $fifoDetails[] = [
                                        'qty' => $usedQty,
                                        'price' => $hargaBahan->harga_beli,
                                        'cost' => $costForThisBatch,
                                        'date' => $hargaBahan->created_at->format('d/m/Y')
                                    ];
                                }
                                
                                $materialCost += $totalCostForMaterial;
                                $materialDetails[] = [
                                    'name' => $bahan->nama_bahan,
                                    'required_qty' => $requiredQty,
                                    'unit' => $bahan->satuan ? $bahan->satuan->nama_satuan : 'kg',
                                    'total_cost' => $totalCostForMaterial,
                                    'avg_price' => $requiredQty > 0 ? $totalCostForMaterial / $requiredQty : 0,
                                    'fifo_details' => $fifoDetails,
                                    'sufficient_stock' => $sisaKebutuhan <= 0
                                ];
                            }
                        } else {
                            // Handle produk material (if needed)
                            $produk = Produk::find($materialId);
                            if ($produk) {
                                // For now, use a default price or calculate from HPP
                                $defaultPrice = 0; // You might want to implement product pricing logic
                                $totalCostForMaterial = $requiredQty * $defaultPrice;
                                $materialCost += $totalCostForMaterial;
                                
                                $materialDetails[] = [
                                    'name' => $produk->nama_produk ?? 'Unknown Product',
                                    'required_qty' => $requiredQty,
                                    'unit' => $produk->unit ?? 'pcs',
                                    'total_cost' => $totalCostForMaterial,
                                    'avg_price' => $defaultPrice,
                                    'fifo_details' => [],
                                    'sufficient_stock' => true
                                ];
                            }
                        }
                    }
                }
            }
            
            // Calculate labor cost
            if ($request->filled('labor_costs.worker_count') && $request->filled('labor_costs.cost_per_worker')) {
                $laborCost = $request->input('labor_costs.worker_count') * $request->input('labor_costs.cost_per_worker');
            } elseif ($request->filled('labor_costs.total_cost')) {
                $laborCost = floatval($request->input('labor_costs.total_cost'));
            }
            
            Log::info('💰 [HPP PREVIEW] Labor cost calculated', ['labor_cost' => $laborCost]);
            
            // Calculate operational cost - Enhanced handling
            if ($request->filled('operational_costs')) {
                Log::info('🔧 [HPP PREVIEW] Processing operational costs', [
                    'operational_costs_data' => $request->operational_costs
                ]);
                
                foreach ($request->operational_costs as $index => $opCost) {
                    if (is_array($opCost) && !empty($opCost['amount'])) {
                        $amount = floatval($opCost['amount']);
                        $costType = $opCost['description'] ?? 'other'; // Use description as cost_type
                        $description = $opCost['description'] ?? '';
                        
                        $operationalCost += $amount;
                        $operationalDetails[] = [
                            'cost_type' => $costType,
                            'amount' => $amount,
                            'description' => $description
                        ];
                        
                        Log::info('🔧 [HPP PREVIEW] Added operational cost', [
                            'index' => $index,
                            'cost_type' => $costType,
                            'amount' => $amount,
                            'running_total' => $operationalCost
                        ]);
                    }
                }
            }
            
            // Also check for calculated operational cost (from monthly costs)
            if ($request->filled('calculatedOperationalCost')) {
                $calculatedOpCost = floatval($request->input('calculatedOperationalCost'));
                if ($calculatedOpCost > 0) {
                    $operationalCost += $calculatedOpCost;
                    $operationalDetails[] = [
                        'cost_type' => 'monthly_calculated',
                        'amount' => $calculatedOpCost,
                        'description' => 'Biaya operasional bulanan terhitung'
                    ];
                    
                    Log::info('🔧 [HPP PREVIEW] Added calculated operational cost', [
                        'calculated_amount' => $calculatedOpCost,
                        'total_operational' => $operationalCost
                    ]);
                }
            }
            
            Log::info('💰 [HPP PREVIEW] Final costs calculated', [
                'material_cost' => $materialCost,
                'labor_cost' => $laborCost,
                'operational_cost' => $operationalCost,
                'operational_details' => $operationalDetails
            ]);
            
            $totalCost = $materialCost + $laborCost + $operationalCost;
            $targetQuantity = $request->input('target_quantity', 1);
            $hppPerUnit = $targetQuantity > 0 ? $totalCost / $targetQuantity : 0;
            
            return response()->json([
                'success' => true,
                'data' => [
                    'material_cost' => $materialCost,
                    'labor_cost' => $laborCost,
                    'operational_cost' => $operationalCost,
                    'total_cost' => $totalCost,
                    'hpp_per_unit' => $hppPerUnit,
                    'target_quantity' => $targetQuantity,
                    'material_details' => $materialDetails,
                    'operational_details' => $operationalDetails,
                    'formatted' => [
                        'material_cost' => 'Rp ' . number_format($materialCost, 0, ',', '.'),
                        'labor_cost' => 'Rp ' . number_format($laborCost, 0, ',', '.'),
                        'operational_cost' => 'Rp ' . number_format($operationalCost, 0, ',', '.'),
                        'total_cost' => 'Rp ' . number_format($totalCost, 0, ',', '.'),
                        'hpp_per_unit' => 'Rp ' . number_format($hppPerUnit, 0, ',', '.'),
                    ]
                ]
            ]);

        } catch (\Exception $e) {
            Log::error('❌ [HPP PREVIEW] Error calculating HPP preview', [
                'error_message' => $e->getMessage(),
                'request_data' => $request->all(),
                'error_trace' => $e->getTraceAsString()
            ]);
            
            return response()->json([
                'success' => false,
                'message' => 'Gagal menghitung HPP: ' . $e->getMessage(),
                'debug_info' => [
                    'request_data' => $request->all(),
                    'error_line' => $e->getLine(),
                    'error_file' => $e->getFile()
                ]
            ], 500);
        }
    }

    /**
     * Export productions to PDF
     */
    public function exportPDF(Request $request)
    {
        try {
            Log::info('PDF Export Start', [
                'request_all' => $request->all(),
                'user_id' => auth()->id(),
                'user_name' => auth()->user()->name ?? 'Unknown'
            ]);

            $outletId = $this->getSelectedOutlet($request);
            
            Log::info('PDF Export Request', [
                'outlet_id' => $outletId,
                'filters' => $request->all(),
                'user_id' => auth()->id(),
                'user_outlets' => $this->getAccessibleOutletIds()
            ]);
            
            // Validate outlet ID
            if (!$outletId) {
                Log::error('PDF Export Error: No outlet selected', [
                    'user_id' => auth()->id(),
                    'accessible_outlets' => $this->getAccessibleOutletIds()
                ]);
                return redirect()->back()->with('error', 'Tidak ada outlet yang dipilih atau Anda tidak memiliki akses ke outlet manapun');
            }
            
            Log::info('PDF Export: Outlet ID validated', ['outlet_id' => $outletId]);
            
            // Validate outlet exists
            $outlet = Outlet::find($outletId);
            if (!$outlet) {
                Log::error('PDF Export Error: Outlet not found', ['outlet_id' => $outletId]);
                return redirect()->back()->with('error', 'Outlet tidak ditemukan');
            }
            
            Log::info('PDF Export: Outlet found', [
                'outlet_id' => $outletId,
                'outlet_name' => $outlet->nama_outlet
            ]);
            
            // Validate user has access to this outlet
            if (!$this->hasOutletAccess($outletId)) {
                Log::error('PDF Export Error: No access to outlet', [
                    'outlet_id' => $outletId,
                    'user_id' => auth()->id()
                ]);
                return redirect()->back()->with('error', 'Anda tidak memiliki akses ke outlet ini');
            }
            
            Log::info('PDF Export: Access validated');
            
            // Build query with filters
            $query = Production::with([
                'product',
                'materials',
                'laborCosts',
                'operationalCosts',
                'realizations',
                'outlet'
            ])->where('outlet_id', $outletId);
            
            Log::info('PDF Export: Base query built');
            
            // Apply filters
            if ($request->filled('status') && $request->status !== 'all') {
                $query->where('status', $request->status);
                Log::info('PDF Export: Status filter applied', ['status' => $request->status]);
            }
            
            if ($request->filled('production_line') && $request->production_line !== 'all') {
                $query->where('production_line', $request->production_line);
                Log::info('PDF Export: Production line filter applied', ['line' => $request->production_line]);
            }
            
            if ($request->filled('start_date')) {
                $query->whereDate('start_date', '>=', $request->start_date);
                Log::info('PDF Export: Start date filter applied', ['start_date' => $request->start_date]);
            }
            
            if ($request->filled('end_date')) {
                $query->whereDate('end_date', '<=', $request->end_date);
                Log::info('PDF Export: End date filter applied', ['end_date' => $request->end_date]);
            }
            
            Log::info('PDF Export: About to execute query', [
                'sql' => $query->toSql(),
                'bindings' => $query->getBindings()
            ]);
            
            $productions = $query->orderBy('created_at', 'desc')->get();
            
            Log::info('Productions found for PDF export', [
                'count' => $productions->count(),
                'outlet_id' => $outletId,
                'outlet_name' => $outlet->nama_outlet,
                'query_sql' => $query->toSql(),
                'query_bindings' => $query->getBindings()
            ]);
            
            // Manually load material relationships
            Log::info('PDF Export: Loading material relationships');
            foreach ($productions as $production) {
                foreach ($production->materials as $material) {
                    if ($material->material_type === 'bahan') {
                        $bahan = Bahan::with('hargaBahan')->find($material->material_id);
                        $material->setRelation('material', $bahan);
                    } else {
                        $produk = Produk::find($material->material_id);
                        $material->setRelation('material', $produk);
                    }
                }
            }
            
            Log::info('PDF Export: Material relationships loaded');
            
            // Calculate totals and statistics
            $totalProductions = $productions->count();
            $totalTarget = $productions->sum('target_quantity');
            $totalRealized = $productions->sum(function($production) {
                return $production->realizations->sum('quantity_produced');
            });
            
            $statusCounts = $productions->groupBy('status')->map->count();
            
            Log::info('PDF Export Statistics', [
                'total_productions' => $totalProductions,
                'total_target' => $totalTarget,
                'total_realized' => $totalRealized
            ]);
            
            // Check if export PDF view exists
            $viewPath = 'admin.produksi.produksi.export-pdf';
            if (!view()->exists($viewPath)) {
                Log::error('PDF Export Error: View not found', ['view' => $viewPath]);
                return redirect()->back()->with('error', 'Template PDF tidak ditemukan');
            }
            
            Log::info('PDF Export: View exists, generating PDF');
            
            // Generate PDF
            $pdf = app('dompdf.wrapper');
            $pdf->loadView($viewPath, compact(
                'productions', 
                'outlet', 
                'totalProductions', 
                'totalTarget', 
                'totalRealized', 
                'statusCounts',
                'request'
            ));
            $pdf->setPaper('A4', 'landscape');
            
            $filename = 'Laporan_Produksi_' . str_replace(' ', '_', $outlet->nama_outlet) . '_' . date('Y-m-d') . '.pdf';
            
            Log::info('PDF Export Success', [
                'filename' => $filename,
                'outlet' => $outlet->nama_outlet
            ]);
            
            return $pdf->stream($filename);
            
        } catch (\Exception $e) {
            Log::error('Production PDF Generation Error', [
                'id' => 'export',
                'error' => $e->getMessage(),
                'trace' => $e->getTraceAsString(),
                'request_data' => $request->all(),
                'line' => $e->getLine(),
                'file' => $e->getFile()
            ]);
            
            return redirect()->back()->with('error', 'Gagal mengekspor data ke PDF: ' . $e->getMessage());
        }
    }
    
    /**
     * Export productions to Excel
     */
    public function exportExcel(Request $request)
    {
        try {
            $outletId = $this->getSelectedOutlet($request);
            
            // Build query with filters
            $query = Production::with([
                'product',
                'materials',
                'laborCosts',
                'operationalCosts',
                'realizations',
                'outlet'
            ])->where('outlet_id', $outletId);
            
            // Apply filters
            if ($request->filled('status') && $request->status !== 'all') {
                $query->where('status', $request->status);
            }
            
            if ($request->filled('production_line') && $request->production_line !== 'all') {
                $query->where('production_line', $request->production_line);
            }
            
            if ($request->filled('start_date')) {
                $query->whereDate('start_date', '>=', $request->start_date);
            }
            
            if ($request->filled('end_date')) {
                $query->whereDate('end_date', '<=', $request->end_date);
            }
            
            $productions = $query->orderBy('created_at', 'desc')->get();
            
            // Manually load material relationships
            foreach ($productions as $production) {
                foreach ($production->materials as $material) {
                    if ($material->material_type === 'bahan') {
                        $bahan = Bahan::with('satuan')->find($material->material_id);
                        $material->setRelation('material', $bahan);
                    } else {
                        $produk = Produk::find($material->material_id);
                        $material->setRelation('material', $produk);
                    }
                }
            }
            
            $outlet = Outlet::find($outletId);
            
            // Create Excel export
            return Excel::download(new ProductionsExport($productions, $outlet, $request), 
                'Laporan_Produksi_' . $outlet->nama_outlet . '_' . date('Y-m-d') . '.xlsx');
            
        } catch (\Exception $e) {
            Log::error('Error exporting productions to Excel: ' . $e->getMessage());
            
            return redirect()->back()->with('error', 'Gagal mengekspor data ke Excel: ' . $e->getMessage());
        }
    }

