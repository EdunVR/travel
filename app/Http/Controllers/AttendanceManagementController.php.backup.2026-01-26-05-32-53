    public function getAvailableFingerprintId()
    {
        // Get all used fingerprint IDs from active employees
        $usedIds = Recruitment::where('status', 'active')
            ->whereNotNull('fingerprint_id')
            ->where('fingerprint_id', '>', 0)
            ->pluck('fingerprint_id')
            ->toArray();

        // Sort used IDs
        sort($usedIds);
        
        // Find first available ID in range 1-200
        $availableId = null;
        for ($i = 1; $i <= 200; $i++) {
            if (!in_array($i, $usedIds)) {
                $availableId = $i;
                break;
            }
        }

        return response()->json([
            'success' => true,
            'available_id' => $availableId,
            'used_ids' => $usedIds,
            'used_count' => count($usedIds)
        ]);
    }

