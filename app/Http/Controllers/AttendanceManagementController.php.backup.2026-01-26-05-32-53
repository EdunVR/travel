    public function storeFromFingerprint(Request $request)
    {
        $validator = Validator::make($request->all(), [
            'fingerprint_id' => 'required|integer',
            'date' => 'required|date',
            'time' => 'required|date_format:H:i',
            'condition' => 'required|in:datang,pulang,istirahat_keluar,istirahat_masuk,lembur_masuk,lembur_keluar'
        ]);

        if ($validator->fails()) {
            return response()->json([
                'success' => false,
                'message' => 'Validasi gagal',
                'errors' => $validator->errors()
            ], 422);
        }

        try {
            DB::beginTransaction();

            // Cari karyawan berdasarkan fingerprint_id
            $employee = Recruitment::where('fingerprint_id', $request->fingerprint_id)
                ->where('status', 'active')
                ->first();

            if (!$employee) {
                return response()->json([
                    'success' => false,
                    'message' => 'Karyawan tidak ditemukan atau tidak aktif'
                ], 404);
            }

            // Cari atau buat absensi hari ini
            $attendance = Attendance::where('recruitment_id', $employee->id)
                ->whereDate('date', $request->date)
                ->first();

            if (!$attendance) {
                $attendance = new Attendance();
                $attendance->recruitment_id = $employee->id;
                $attendance->employee_name = $employee->name;
                $attendance->fingerprint_id = $employee->fingerprint_id;
                $attendance->date = $request->date;
                $attendance->status = 'present';
                
                // Get outlet_id
                $attendance->outlet_id = $employee->outlet_id ?? 1;
                
                // Gunakan user system (id=1) atau NULL jika tidak ada user system
                $systemUserId = \App\Models\User::where('email', 'system@system.com')->first()->id ?? null;
                $attendance->created_by = $systemUserId;
            }

            // Format waktu
            $timeWithSeconds = $request->time . ':00';

            // Update field sesuai kondisi
            switch ($request->condition) {
                case 'datang':
                    $attendance->clock_in = $timeWithSeconds;
                    break;
                    
                case 'pulang':
                    $attendance->clock_out = $timeWithSeconds;
                    break;
                    
                case 'istirahat_keluar':
                    $attendance->break_out = $timeWithSeconds;
                    break;
                    
                case 'istirahat_masuk':
                    $attendance->break_in = $timeWithSeconds;
                    break;
                    
                case 'lembur_masuk':
                    $attendance->overtime_in = $timeWithSeconds;
                    break;
                    
                case 'lembur_keluar':
                    $attendance->overtime_out = $timeWithSeconds;
                    break;
            }

            // Bersihkan data sebelum auto-calculate
            $this->cleanAttendanceTimeFields($attendance);
            
            // Auto-calculate
            $attendance->autoCalculate();
            $attendance->save();

            DB::commit();

            return response()->json([
                'success' => true,
                'message' => 'Absensi berhasil dicatat',
                'data' => [
                    'id' => $attendance->id,
                    'employee_name' => $attendance->employee_name,
                    'condition' => $request->condition,
                    'time' => $request->time,
                    'status' => $attendance->status,
                    'clock_in' => $attendance->clock_in,
                    'clock_out' => $attendance->clock_out,
                    'break_out' => $attendance->break_out,
                    'break_in' => $attendance->break_in,
                    'overtime_in' => $attendance->overtime_in,
                    'overtime_out' => $attendance->overtime_out,
                ]
            ]);

        } catch (\Exception $e) {
            DB::rollBack();
            \Log::error('Error storing fingerprint attendance: ' . $e->getMessage());
            \Log::error('Stack trace: ' . $e->getTraceAsString());
            
            return response()->json([
                'success' => false,
                'message' => 'Terjadi kesalahan sistem: ' . $e->getMessage()
            ], 500);
        }
    }

    /**
     * Bersihkan field waktu untuk menghindari double date
     */
    private function cleanAttendanceTimeFields($attendance)
    {
        $timeFields = ['clock_in', 'clock_out', 'break_out', 'break_in', 'overtime_in', 'overtime_out'];
        
        foreach ($timeFields as $field) {
            if (!empty($attendance->$field)) {
                $timeValue = trim($attendance->$field);
                
                // Skip jika sudah null atau kosong
                if (empty($timeValue) || $timeValue === '00:00:00') {
                    $attendance->$field = null;
                    continue;
                }
                
                // Handle malformed strings like "2025-12-12 00:00:00 05:01:00" (double time specification)
                if (preg_match('/^\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}\s+\d{2}:\d{2}:\d{2}$/', $timeValue)) {
                    // Extract the last time component (the actual time we want)
                    $parts = explode(' ', $timeValue);
                    $attendance->$field = end($parts);
                    \Log::info("Fixed malformed time field {$field}: {$timeValue} -> " . end($parts));
                }
                // Jika mengandung tanggal dan waktu (format: YYYY-MM-DD HH:MM:SS)
                elseif (preg_match('/^\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}$/', $timeValue)) {
                    // Ambil hanya bagian waktu (setelah spasi)
                    $parts = explode(' ', $timeValue);
                    $attendance->$field = end($parts);
                }
                // Jika hanya waktu tanpa detik (HH:MM)
                elseif (preg_match('/^\d{2}:\d{2}$/', $timeValue)) {
                    $attendance->$field = $timeValue . ':00';
                }
                // Jika sudah format HH:MM:SS, biarkan apa adanya
                elseif (preg_match('/^\d{2}:\d{2}:\d{2}$/', $timeValue)) {
                    $attendance->$field = $timeValue;
                }
                // Handle other malformed formats - extract any valid time pattern
                elseif (preg_match('/(\d{2}:\d{2}:\d{2})/', $timeValue, $matches)) {
                    $attendance->$field = $matches[1];
                    \Log::info("Extracted time from malformed field {$field}: {$timeValue} -> {$matches[1]}");
                }
                // Jika format tidak dikenali, set null
                else {
                    \Log::warning("Unknown time format for field {$field}: {$timeValue}");
                    $attendance->$field = null;
                }
            }
        }
    }

