    /**
     * API: Register RFID card for employee (ESP32 CAM)
     */
    public function registerRfidCard(Request $request)
    {
        $validator = Validator::make($request->all(), [
            'uid' => 'required|string|max:50',
            'employee_id' => 'required|exists:recruitments,id'
        ]);

        if ($validator->fails()) {
            return response()->json([
                'success' => false,
                'message' => 'Validasi gagal',
                'errors' => $validator->errors()
            ], 422);
        }

        try {
            DB::beginTransaction();

            // Check if UID already exists
            $existingEmployee = Recruitment::where('rfid_uid', $request->uid)
                ->where('id', '!=', $request->employee_id)
                ->first();

            if ($existingEmployee) {
                return response()->json([
                    'success' => false,
                    'message' => 'UID kartu sudah digunakan oleh karyawan lain: ' . $existingEmployee->name
                ], 422);
            }

            // Update employee with RFID UID
            $employee = Recruitment::findOrFail($request->employee_id);
            $employee->rfid_uid = $request->uid;
            $employee->save();

            DB::commit();

            return response()->json([
                'success' => true,
                'message' => 'UID kartu berhasil didaftarkan untuk ' . $employee->name,
                'data' => [
                    'employee_id' => $employee->id,
                    'employee_name' => $employee->name,
                    'rfid_uid' => $employee->rfid_uid
                ]
            ]);

        } catch (\Exception $e) {
            DB::rollBack();
            \Log::error('Error registering RFID card: ' . $e->getMessage());
            
            return response()->json([
                'success' => false,
                'message' => 'Terjadi kesalahan sistem: ' . $e->getMessage()
            ], 500);
        }
    }

