        ]);

        if ($validator->fails()) {
            return response()->json([
                'success' => false,
                'message' => 'UID kartu tidak valid'
            ], 422);
        }

        try {
            $uid = $request->uid;
            $mode = \Cache::get('esp32_rfid_mode', 'attendance');

            if ($mode === 'register') {
                // Mode register: simpan UID untuk pendaftaran
                \Cache::put('detected_rfid_uid', $uid, 300); // 5 minutes
                
                // Reset mode back to attendance after successful detection
                \Cache::put('esp32_rfid_mode', 'attendance', 600);
                \DB::table('system_settings')->updateOrInsert(
                    ['key' => 'esp32_rfid_mode'],
                    ['value' => 'attendance', 'updated_at' => now()]
                );

                return response()->json([
                    'success' => true,
                    'message' => 'Kartu terdeteksi untuk pendaftaran',
                    'action' => 'register',
                    'uid' => $uid,
                    'mode_changed_to' => 'attendance'
                ]);

            } else {
                // Mode attendance: proses absensi dengan time-based logic
                $employee = Recruitment::where('rfid_uid', $uid)
                    ->where('status', 'active')
                    ->first();

                if (!$employee) {
                    return response()->json([
                        'success' => false,
                        'message' => 'Kartu tidak terdaftar atau karyawan tidak aktif',
                        'action' => 'attendance',
                        'uid' => $uid
                    ], 404);
                }

                // Get current time and determine time period
                $today = now()->format('Y-m-d');
                $currentTime = now()->format('H:i:s');
                $currentTimePeriod = AttendanceTimeSetting::getCurrentTimePeriod($currentTime);

                // Get existing attendance for today
                $attendance = Attendance::where('recruitment_id', $employee->id)
                    ->whereDate('date', $today)
                    ->first();

                // Determine next action based on time period and current attendance
                $nextAction = AttendanceTimeSetting::determineNextAction($attendance, $currentTimePeriod);
                $actionDescription = AttendanceTimeSetting::getActionDescription($nextAction);

                // Create attendance record if doesn't exist
                if (!$attendance) {
                    // Get first available user ID or use null (since created_by is nullable)
                    $systemUserId = \DB::table('users')->orderBy('id')->value('id');
                    
                    $attendance = new Attendance();
                    $attendance->recruitment_id = $employee->id;
                    $attendance->employee_name = $employee->name;
                    $attendance->fingerprint_id = $employee->fingerprint_id;
                    $attendance->rfid_uid = $employee->rfid_uid;
                    $attendance->date = $today;
                    $attendance->status = 'present';
                    $attendance->outlet_id = $employee->outlet_id ?? 1;
                    $attendance->created_by = $systemUserId;
                }

                // Update attendance based on determined action
                $timeWithSeconds = $currentTime;
                $previousValue = null;

                switch ($nextAction) {
                    case 'clock_in':
                        $previousValue = $attendance->clock_in;
                        $attendance->clock_in = $timeWithSeconds;
                        break;
                        
                    case 'clock_out':
                        $previousValue = $attendance->clock_out;
                        $attendance->clock_out = $timeWithSeconds;
                        break;
                        
                    case 'break_in':
                        $previousValue = $attendance->break_in;
                        $attendance->break_in = $timeWithSeconds;
                        break;
                        
                    case 'break_out':
                        $previousValue = $attendance->break_out;
                        $attendance->break_out = $timeWithSeconds;
                        break;
                        
                    case 'overtime_in':
                        $previousValue = $attendance->overtime_in;
                        $attendance->overtime_in = $timeWithSeconds;
                        break;
                        
                    case 'overtime_out':
                        $previousValue = $attendance->overtime_out;
                        $attendance->overtime_out = $timeWithSeconds;
                        break;
                }

                // Auto-calculate all metrics and save
                $attendance->autoCalculate();
                $attendance->save();

                // Prepare response message
                $timePeriodName = $currentTimePeriod ? ucfirst($currentTimePeriod) : 'Diluar jam kerja';
                $message = "{$actionDescription} berhasil dicatat untuk {$employee->name}";
                
                if ($previousValue) {
                    $message .= " (Update dari {$previousValue})";
                }

                return response()->json([
                    'success' => true,
                    'message' => $message,
                    'action' => 'attendance',
                    'employee' => [
                        'name' => $employee->name,
                        'position' => $employee->position
                    ],
                    'attendance' => [
                        'action' => $nextAction,
                        'action_description' => $actionDescription,
                        'time_period' => $timePeriodName,
                        'time' => date('H:i', strtotime($currentTime)),
                        'clock_in' => $attendance->clock_in,
                        'clock_out' => $attendance->clock_out,
                        'break_out' => $attendance->break_out,
                        'break_in' => $attendance->break_in,
                        'overtime_in' => $attendance->overtime_in,
                        'overtime_out' => $attendance->overtime_out,
                        'previous_value' => $previousValue
                    ],
                    'time_settings' => [
                        'current_period' => $currentTimePeriod,
                        'available_periods' => AttendanceTimeSetting::getActiveSettings()->map(function($setting) {
                            return [
                                'name' => $setting->name,
                                'start_time' => $setting->start_time,
                                'end_time' => $setting->end_time,
                                'description' => $setting->description
                            ];
                        })
                    ]
                ]);
            }

        } catch (\Exception $e) {
            \Log::error('Error handling card detection: ' . $e->getMessage());
            
            return response()->json([
                'success' => false,
                'message' => 'Terjadi kesalahan sistem: ' . $e->getMessage()
            ], 500);
        }
    }

