    /**
     * API: Update attendance time settings
     */
    public function updateTimeSettings(Request $request)
    {
        // Log incoming request for debugging
        \Log::info('Time Settings Update Request:', [
            'all_data' => $request->all(),
            'settings' => $request->get('settings'),
            'content_type' => $request->header('Content-Type'),
            'method' => $request->method()
        ]);

        $validator = Validator::make($request->all(), [
            'settings' => 'required|array',
            'settings.*.id' => 'required|exists:attendance_time_settings,id',
            'settings.*.start_time' => 'required|date_format:H:i',
            'settings.*.end_time' => 'required|date_format:H:i',
            'settings.*.is_active' => 'boolean'
        ], [
            'settings.*.start_time.date_format' => 'Format jam mulai harus HH:MM (24 jam)',
            'settings.*.end_time.date_format' => 'Format jam selesai harus HH:MM (24 jam)',
        ]);

        if ($validator->fails()) {
            \Log::error('Time Settings Validation Failed:', [
                'errors' => $validator->errors()->toArray(),
                'input' => $request->all()
            ]);
            
            return response()->json([
                'success' => false,
                'message' => 'Validasi gagal',
                'errors' => $validator->errors(),
                'debug_info' => [
                    'received_data' => $request->all(),
                    'validation_rules' => [
                        'settings' => 'required|array',
                        'settings.*.id' => 'required|exists:attendance_time_settings,id',
                        'settings.*.start_time' => 'required|date_format:H:i',
                        'settings.*.end_time' => 'required|date_format:H:i',
                        'settings.*.is_active' => 'boolean'
                    ]
                ]
            ], 422);
        }

        try {
            DB::beginTransaction();

            foreach ($request->settings as $settingData) {
                $setting = AttendanceTimeSetting::findOrFail($settingData['id']);
                
                // Validate time format and convert to HH:MM:SS
                $startTime = $settingData['start_time'];
                $endTime = $settingData['end_time'];
                
                // Add seconds if not present
                if (strlen($startTime) === 5) {
                    $startTime .= ':00';
                }
                if (strlen($endTime) === 5) {
                    $endTime .= ':00';
                }
                
                $setting->start_time = $startTime;
                $setting->end_time = $endTime;
                $setting->is_active = $settingData['is_active'] ?? true;
                $setting->save();
            }

            DB::commit();

            return response()->json([
                'success' => true,
                'message' => 'Pengaturan waktu berhasil diupdate',
                'settings' => AttendanceTimeSetting::getActiveSettings()
            ]);

        } catch (\Exception $e) {
            DB::rollBack();
            \Log::error('Error updating time settings: ' . $e->getMessage());
            
            return response()->json([
                'success' => false,
                'message' => 'Terjadi kesalahan sistem: ' . $e->getMessage()
            ], 500);
        }
    }

